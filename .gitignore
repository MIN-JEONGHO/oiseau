# 이 저장소에는 보안등급분류 시뮬레이터만 올린다.
# 다른 폴더와 PC 전용 지침·문서는 PC에서만 관리한다.
/dev/*
!/dev/보안등급분류 시뮬레이터/
CLAUDE.local.md
docs-local/

# 키·비밀 값이 들어갈 수 있는 파일
embedded_key.py
**/_secrets.py
.env
dev/보안등급분류 시뮬레이터/security_grade_classifier_v10_claude.py
dev/보안등급분류 시뮬레이터/security_grade_classifier_v12_claude.py

# 도구 작업 폴더·로컬 설정
.dryforge/
.bkit/
**/.claude/settings.local.json
.venv/

# 빌드 결과물 — exe 안에는 내장 키가 함께 묶일 수 있다
build/
dist/
dist-v15/
build-v16/
dist-v16/
*.exe
*.zip
__pycache__/
*.py[cod]

# 실행 산출물(업무 자료)
분류_감사로그.jsonl
