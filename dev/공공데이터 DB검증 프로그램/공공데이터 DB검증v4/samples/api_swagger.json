{
  "swagger": "2.0",
  "info": {
    "title": "자전거보관소 정보 서비스",
    "description": "위반 사례를 일부러 섞어 둔 검토용 예시 기술문서입니다."
  },
  "host": "apis.data.go.kr",
  "basePath": "/15012345/BikeInfoService",
  "schemes": ["https"],
  "produces": ["application/json;charset=UTF-8"],
  "paths": {
    "/getBikeList": {
      "get": {
        "operationId": "getBikeList",
        "summary": "자전거보관소 목록 조회",
        "parameters": [
          {
            "name": "serviceKey", "in": "query", "required": true,
            "type": "string", "description": "공공데이터포털에서 발급받은 인증키",
            "example": "abcdefg1234"
          },
          {
            "name": "areaCd", "in": "query", "required": false,
            "type": "string", "description": ""
          }
        ],
        "responses": {
          "200": {"description": "정상", "schema": {"$ref": "#/definitions/Resp"}},
          "500": {"description": "서버 오류"}
        }
      }
    }
  },
  "definitions": {
    "Resp": {
      "type": "object",
      "properties": {
        "resultCode": {"type": "string", "description": "결과코드"},
        "resultMsg": {"type": "string", "description": "결과메시지"},
        "items": {"type": "array", "items": {"$ref": "#/definitions/Item"}}
      }
    },
    "Item": {
      "type": "object",
      "properties": {
        "bikeStationNm": {"type": "string", "description": "보관소 이름"},
        "면적(㎡)": {"type": "string", "description": "보관소 면적"},
        "mobileNo": {"type": "string", "description": "관리자 휴대전화번호"},
        "areaCd": {"type": "string", "description": ""}
      }
    }
  },
  "x-error-codes": [
    {"code": "30", "message": "SERVICE_KEY_IS_NOT_REGISTERED_ERROR"},
    {"code": "200", "message": "정상"},
    {"code": "A01", "message": "보관소 코드가 올바르지 않습니다"}
  ]
}
