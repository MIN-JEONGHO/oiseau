  "items": [
    {
      "clause_id": "military:control:ML1",
      "title": "구경이 20mm 미만인 활강무기와 구경 12.7mm 이하의 화기 및 자동무기",
      "branches": [
        {
          "label": "활강무기",
          "thresholds": [
            {
              "subject": "활강무기 구경",
              "operator": "lt",
              "value": "20",
              "unit": "mm",
              "quote": "구경이 20mm 미만인 활강무기",
              "quote_source": "항목 본문"
            }
          ],
          "text": ""
        },
        {
          "label": "화기 및 자동무기",
          "thresholds": [
            {
              "subject": "화기 구경",
              "operator": "le",
              "value": "12.7",
              "unit": "mm",
              "quote": "구경 12.7mm (0.50 in.) 이하의 화기 및 자동무기",
              "quote_source": "항목 본문"
            }
          ],
          "text": ""
        }
      ],
      "checks": [
        {
          "quote": "발사체를 발포할 수 없는 모의탄용으로 전용 설계된 화기",
          "source": "항목 본문"
        },
        {
          "quote": "고폭장약 혹은 통신링크가 없는 연결형(tethered) 발사체를 발사하도록 전용        설계된 사거리 500m 이하의 화기",
          "source": "항목 본문"
        },
        {
          "quote": "중앙격발식이 아닌 탄약을 사용하고, 완전 자동 발사식이 아닌 무기류",
          "source": "항목 본문"
        },
        {
          "quote": "사냥이나 스포츠용으로 사용되는 활강무기: 군용 혹은 완전 자동발사형           활강무기로 전용 설계되지 않아야 한다",
          "source": "항목 본문"
        },
        {
          "quote": "압축공기나 이산화탄소로 비활성 발사체를 발사하기 위해 전용 설계된            소총 또는 권총",
          "source": "항목 본문"
        }
      ]
    },
    {
      "clause_id": "military:control:ML2",
      "title": "구경이 20 mm 이상인 활강무기, 구경 12.7mm를 초과하는 무기",
      "branches": [
        {
          "label": "활강무기",
          "thresholds": [
            {
              "subject": "활강무기 구경",
              "operator": "ge",
              "value": "20",
              "unit": "mm",
              "quote": "구경이 20 mm 이상인 활강무기",
              "quote_source": "항목 본문"
            }
          ],
          "text": ""
        },
        {
          "label": "무기(Armament or Weapon)",
          "thresholds": [
            {
              "subject": "무기 구경",
              "operator": "gt",
              "value": "12.7",
              "unit": "mm",
              "quote": "구경 12.7mm(0.50 in.)를 초과하는 무기(Armament or Weapon)",
              "quote_source": "항목 본문"
            }
          ],
          "text": ""
        },
        {
          "label": "b. 발사기",
          "thresholds": [],
          "text": "발사기, 군용으로 전용 설계 되거나 개조된 다음의 것"
        }
      ],
      "checks": [
        {
          "quote": "사냥과 스포츠 목적으로 사용되는 활강무기",
          "source": "항목 본문"
        },
        {
          "quote": "고폭 장약 혹은 통신링크가 없는 연결형(tethered) 발사체를 발사하도록              전용 설계된 사거리 500m 이하의 휴대형 발사기",
          "source": "항목 본문"
        },
        {
          "quote": "ML2.b.항은 신호용 권총에 적용되지 않는다",
          "source": "항목 본문"
        }
      ]
    },
    {
      "clause_id": "military:control:ML3",
      "title": "다음의 탄약과 신관장입기 및 이의 전용 설계된 구성품",
      "branches": [],
      "checks": [
        {
          "quote": "ML1, ML2, ML12에 의해 명시되는 무기류의 탄약",
          "source": "항목 본문"
        },
        {
          "quote": "탄자없이 탄피가 크림핑된 공포탄",
          "source": "항목 본문"
        },
        {
          "quote": "실탄용으로 설계된 구성품을 포함하지 않는 공포탄과 모의탄",
          "source": "항목 본문"
        },
        {
          "quote": "ML3.a.은 다음의 목적을 위하여 전용 설계된 탄약은 통제하지 않는다",
          "source": "항목 본문"
        }
      ]
    },
    {
      "clause_id": "military:control:ML4",
      "title": "폭탄, 어뢰, 로켓, 미사일, 기타 폭발장치와 장약 및 관련 장비",
      "branches": [],
      "checks": [
        {
          "quote": "군용으로 전용 설계된 폭탄, 어뢰, 수류탄, 연막통, 로켓, 지뢰, 미사일, 폭뢰, 폭파장약과 폭파장치, 폭파키트, 파이로테크닉 장치, 카트리지",
          "source": "항목 본문"
        },
        {
          "quote": "ML4.b.항은 금속 탐지만을 할 수 있고 지뢰와 다른 금속물질을 구분할           수 없는 제한적인 소형 휴대용 장비는 제외한다",
          "source": "항목 본문"
        },
        {
          "quote": "100-400nm 사이의 최대응답을 갖는 수동 센서",
          "source": "항목 본문"
        },
        {
          "quote": "ML4.c는 다음의 모든 특징을 갖는 AMPS는 제외한다",
          "source": "항목 본문"
        }
      ]
    },
    {
      "clause_id": "military:control:ML5",
      "title": "군용으로 전용 설계된 사격 통제 장비, 감시·경고장치와 관련 시스템",
      "branches": [],
      "checks": [
        {
          "quote": "군용으로 전용 설계된 사격 통제 장비, 감시·경고장치와 관련 시스템 및 시험, 정렬, 대응장비 장비",
          "source": "항목 본문"
        },
        {
          "quote": "표적 인식, 표적지시, 사거리 판별, 감시 또는 추적 시스템",
          "source": "항목 본문"
        }
      ]
    },
    {
      "clause_id": "military:control:ML6",
      "title": "지상차량과, 이의 구성품으로 다음의 것",
      "branches": [
        {
          "label": "b.1. 전륜구동 차량(모든 조건)",
          "thresholds": [
            {
              "subject": "최대허용중량(GVWR)",
              "operator": "ge",
              "value": "4500",
              "unit": "kg",
              "quote": "4,500kg 이상의 최대허용중량(GVWR)용 트랜스미션",
              "quote_source": "항목 본문"
            }
          ],
          "text": ""
        }
      ],
      "checks": [
        {
          "quote": "군용으로 전용 설계되거나 개조된 지상차량과 구성품",
          "source": "항목 본문"
        },
        {
          "quote": "level III (NIJ 0108.01, 1985년 9월 제정된 규정) 또는“동등기준”이상인\n          방탄 특성을 갖는 재료로 제조되거나 이를 장착한 것",
          "source": "항목 본문"
        },
        {
          "quote": "ML6은 돈이나 귀중품의 수송을 위하여 설계되거나 개조된 일반 차량은 \n        제외한다",
          "source": "항목 본문"
        },
        {
          "quote": "1946년 이전에 생산된 차량",
          "source": "항목 본문"
        }
      ]
    },
    {
      "clause_id": "military:control:ML7",
